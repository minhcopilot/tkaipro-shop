NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_YANDEX_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# IndexNow: chuỗi hex tự đặt, đồng thời phải đặt file
