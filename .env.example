# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.
#
# LƯU Ý QUAN TRỌNG về NEXT_PUBLIC_*:
# Next.js nhúng các biến này thẳng vào JavaScript bundle lúc BUILD, không đọc
# lúc chạy. Đổi giá trị thì phải build lại image (`scripts/deploy.sh`), restart
# container không có tác dụng. Chúng cũng lộ ra cho trình duyệt — tuyệt đối
# không đặt secret vào biến NEXT_PUBLIC_*.

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― THƯƠNG HIỆU & TÊN MIỀN ―――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Không có dấu / ở cuối. Dev: http://localhost:3003
NEXT_PUBLIC_BASE_URL="https://tkaipro.shop"
NEXT_SERVER_APP_URL="https://tkaipro.shop"

NEXT_PUBLIC_SITE_NAME="TKAIPro"
NEXT_PUBLIC_SITE_FULL_NAME="TKAIPro - Google AI accounts"

# Để trống thì UI tự ẩn kênh liên hệ đó đi.
NEXT_PUBLIC_SUPPORT_TELEGRAM=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_MESSENGER=""
NEXT_PUBLIC_SUPPORT_FACEBOOK=""

# Email nhận thông báo đơn hàng mới (phía server, không lộ ra client).
ADMIN_NOTIFICATION_EMAIL=""

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― DATABASE ――――――――――――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Trên VPS: host `postgres` là container Postgres dùng chung trên mạng
# app-network. Mỗi shop một database riêng, một user riêng.
# Mật khẩu do scripts/setup-vps.sh sinh ra và in ra màn hình đúng một lần.
DATABASE_URL="postgres://tkaipro_app:MATKHAU@postgres:5432/tkaipro"

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― XÁC THỰC ――――――――――――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Sinh khoá mới cho shop này, KHÔNG dùng lại khoá của shop khác:
#   openssl rand -base64 32
AUTH_SECRET=""
BETTER_AUTH_SECRET=""

# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXT_PUBLIC_BASE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# https://github.com/settings/developers
# Callback URL: <NEXT_PUBLIC_BASE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― THANH TOÁN (SePay) ――――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# https://my.sepay.vn → API tokens. BẮT BUỘC ở production:
# webhook trả 401 nếu biến này trống.
# Webhook URL khai báo bên SePay: <NEXT_PUBLIC_BASE_URL>/api/webhooks/sepay
SEPAY_API_KEY=""

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ―― MÃ HOÁ KHO TÀI KHOẢN ―――――――――――――――――――
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# BẮT BUỘC: khoá 32 byte dạng 64 ký tự hex — dùng để mã hoá mật khẩu tài khoản
# trong kho. Sinh bằng: openssl rand -hex 32
#
# CẢNH BÁO: mất khoá này là không giải mã lại được kho tài khoản đã nhập. Đổi
# khoá cũng làm hỏng toàn bộ bản ghi cũ. Sao lưu ở nơi an toàn.
CREDENTIAL_ENC_KEY=""

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
